---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Stopka from '../components/Stopka.astro';
import { Image } from 'astro:assets';
import zdjecie from '../assets/michal-hebda.jpg';

/**
 * BRIEF-11 (Klaudiusz, 6.08). Treść wg sekcji A briefu, ceny wg aktualizacji
 * ze Slacka: 299 / 254 / 199 / pakiet 749.
 *
 * ⚠️ CENY BEZ PRZEKREŚLEŃ — decyzja Michała z 6.08, wbrew pierwotnemu pomysłowi
 * na „~299 zł~ → 199 zł, −33%". Powód: dyrektywa Omnibus każe pokazywać przy
 * obniżce najniższą cenę z ostatnich 30 dni, a 299 zł zaczyna obowiązywać
 * dopiero dziś — nikt jej jeszcze nie zapłacił. Przekreślenie ceny, która nigdy
 * nie obowiązywała, to dokładnie ten wzór, który ściga UOKiK.
 *
 * Przekaz jest ten sam, tylko powiedziany słowami zamiast grafiką przeceny.
 * Po 30 dniach obowiązywania 299 zł wystarczy przestawić PRZEKRESLENIA na true
 * — reszta jest już przygotowana.
 */
const PRZEKRESLENIA = false;
const CENA = { baza: 299, subskrybent: 254, pakiet: 749, pakietOsobno: 897 };
/* 3.11.2026: cena startowa 199 zł (do 31.10) zdjęta — faza 0 przebudowy. */
const rabat = (z: number) => Math.round((1 - z / CENA.baza) * 100);
/* Koszyki EasyCart (3.11.2026, przebudowa): płatność od razu, termin mailem w 24 h.
   Docelowo rezerwacja z kalendarzem (faza 3 — Zoho Bookings / Calendly). */
const KOSZYK_KONSULTACJA = 'https://cart.easy.tools/checkout/michalbezstresu/konsultacja-60-minut?utm_source=site&utm_medium=konsultacje&utm_campaign=umow-rozmowe';
const KOSZYK_PIP = 'https://cart.easy.tools/checkout/michalbezstresu/pakiet-przetrwaj-pip?utm_source=site&utm_medium=konsultacje&utm_campaign=pakiet-pip';
---
<Layout
  title="Konsultacje indywidualne — Michał bez Stresu"
  description="Jesteś po trudnej rozmowie z szefem, po ocenie, z którą się nie zgadzasz, albo bez podwyżki, na którą liczyłeś? Godzina jeden na jeden z kimś, kto siedział po obu stronach tego stołu."
>
  <Nav />

  <header class="khead">
    <div class="wrap">
      <div class="eyebrow">Konsultacje</div>
      <h1>Jesteś po trudnej rozmowie z szefem? Porozmawiajmy o Twojej sytuacji</h1>
      <p class="lead">Dostałeś ocenę, z którą się nie zgadzasz, bo uważasz, że zasługujesz na
        więcej? Nie dostałeś podwyżki albo awansu, na który liczyłeś? Masz przed sobą rozmowę,
        którą chcesz przegadać na konkretach, a nie na ogólnych zasadach? Jeśli szukasz sposobu
        na rozwiązanie swojego problemu, napisz do mnie. Przez godzinę zajmiemy się wyłącznie
        Twoją sytuacją, z kimś, kto siedział po obu stronach tego stołu, i wspólnie poszukamy
        rozwiązania.</p>
      <p class="lead">Filmy i podcast dają wiedzę ogólną: jak działa system, jakie są zasady gry.
        Ale Twoja sytuacja nie jest ogólna. Ma nazwiska, daty, konkretny dokument na stole
        i konkretną rozmowę w kalendarzu.</p>
      <p class="pilnosc">Jeśli rozmowa o podwyżce albo ocena roczna czeka Cię w najbliższych
        tygodniach, najlepszy moment na przygotowanie jest teraz — nie tydzień przed.</p>
      <div class="head-cta">
        <a class="btn btn-primary" href="#umow">Umów rozmowę</a>
        <a class="btn btn-ghost" href="#formularz">Najpierw napiszę o sytuacji</a>
      </div>
    </div>
  </header>

  <main class="wrap">
    <section class="blok">
      <h2>Z czym ludzie do mnie przychodzą</h2>
      <ul class="lista">
        <li>Dostałem trudny feedback albo niską ocenę roczną — co teraz?</li>
        <li>Wręczono mi PIP — jak przez to przejść z głową?</li>
        <li>Nie wiem, czy to jeszcze wymagający szef, czy już coś więcej</li>
        <li>Mam przed sobą trudną rozmowę — ocena, podwyżka, porozumienie stron — i chcę się przygotować</li>
        <li>Czuję, że tracę grunt i chcę uporządkować sytuację oraz opcje</li>
      </ul>
    </section>

    <section class="blok">
      <h2>Jak to wygląda</h2>
      <ol class="kroki">
        <li><strong>Umawiasz rozmowę i płacisz online</strong> — albo, jeśli wolisz, najpierw piszesz
          przez formularz niżej lub na <a href="mailto:michal@michalbezstresu.pl">michal@michalbezstresu.pl</a>.</li>
        <li><strong>W ciągu 24 godzin dostajesz ode mnie propozycję terminów.</strong> Jeśli Twoja sprawa
          wymaga prawnika albo psychologa, powiem Ci to wprost — i zwrócę pieniądze w całości.</li>
        <li><strong>Rozmawiamy online, 60 minut.</strong> Wcześniej dostajesz ode mnie kilka pytań,
          żeby ten czas pracował na Ciebie od pierwszej minuty.</li>
        <li><strong>Po rozmowie dostajesz podsumowanie</strong>: co ustaliliśmy, plan kroków
          i gotowe sformułowania na Twoją sytuację.</li>
      </ol>
    </section>

    <section class="blok przyklad">
      <h2>Przykład: jak przygotowujemy rozmowę o podwyżce</h2>
      <p class="przyklad-nota"><em>To ilustracja przebiegu konsultacji, a nie opinia klienta.</em></p>
      <dl class="przyklad-kroki">
        <dt>Przed spotkaniem</dt>
        <dd>Opisujesz sytuację w formularzu — stanowisko, kiedy rozmowa, co już padło.</dd>
        <dt>Na spotkaniu (60 min)</dt>
        <dd>Przechodzimy rozmowę z obu stron stołu: czego będzie potrzebował Twój przełożony,
          żeby „sprzedać” podwyżkę wyżej, jakie pytania padną i jak na nie odpowiesz.
          Ćwiczymy trzy najtrudniejsze momenty.</dd>
        <dt>Po spotkaniu</dt>
        <dd>Dostajesz na maila notatkę: Twoje 3 argumenty z liczbami, kwotę i jej uzasadnienie,
          plan na „budżety są zamknięte”.</dd>
      </dl>
    </section>

    <section class="blok" id="cennik">
      <h2>Ile to kosztuje</h2>
      <p class="kotwica">Godzina rozmowy z kimś, kto przez dwadzieścia lat siedział po obu
        stronach tego stołu. Dla porównania: dzień szkolenia otwartego z trudnych rozmów
        to zwykle 900–1300 zł netto od osoby — i mówi się na nim do sali, nie o Tobie.</p>
      <p class="uwaga">Wszystkie ceny zawierają VAT.</p>
      <div class="ceny">
        <article class="cena">
          <div class="kwota">{CENA.baza} zł</div>
          <h3>Konsultacja 60 minut</h3>
          <p>Jeśli rozmowa musi potrwać dłużej — potrwa. Rozliczamy się uczciwie,
            nie z zegarkiem w ręku.</p>
        </article>

        <article class="cena">
          <div class="kwota">
            {PRZEKRESLENIA && <s class="stara">{CENA.baza} zł</s>}
            {CENA.subskrybent} zł
            {PRZEKRESLENIA && <span class="badge">−{rabat(CENA.subskrybent)}%</span>}
          </div>
          <h3>Dla subskrybentów newslettera</h3>
          <p>Kod rabatowy −15% dostajesz w mailu powitalnym i masz go w stopce każdego
            newslettera. Wpisujesz go w koszyku przy płatności albo w formularzu niżej.</p>
        </article>

        <article class="cena pip" id="pip">
          <span class="etykieta">Dostałeś plan naprawczy?</span>
          <div class="kwota">{CENA.pakiet} zł</div>
          <h3>Pakiet „Przetrwaj PIP”: trzy sesje w rytmie planu naprawczego</h3>
          <ul class="pip-lista">
            <li><strong>Sesja 1, na start:</strong> czytamy Twój PIP punkt po punkcie — co jest mierzalne,
              co nieprecyzyjne, o co dopytać, zanim podpiszesz. Strategia na cały okres.</li>
            <li><strong>Sesja 2, w połowie:</strong> postępy względem celów, korekta strategii,
              przygotowanie do rozmów kontrolnych.</li>
            <li><strong>Sesja 3, przed finałem:</strong> przygotowanie do rozmowy podsumowującej,
              niezależnie od scenariusza.</li>
          </ul>
          <p>Między sesjami możesz pisać do mnie maile — odpowiadam w 48 h (dni robocze).
            Osobno trzy sesje to {CENA.pakietOsobno} zł.</p>
          <a class="btn btn-primary" href={KOSZYK_PIP} data-koszyk="pip">Kupuję pakiet PIP</a>
        </article>
      </div>
      <p class="uwaga pomost">Nie jesteś gotowy na rozmowę albo 299 zł to dziś za dużo?
        <a href="/pytanie/">Zadaj pytanie anonimowo</a> — odpowiadam na jedno w tygodniu
        w newsletterze. Bez nazwisk, bez nazwy firmy, bez zobowiązań. Albo
        <a href="/symulator/podwyzka/">przećwicz rozmowę o podwyżce w symulatorze</a> — 3 minuty.</p>
      <p class="pomost-ksiazka"><strong>Mój e-book <em>„Z obu stron stołu”</em> już jest: 39 zł do 15.11.</strong>
        <a href="/ksiazka/?utm_source=site&utm_medium=konsultacje&utm_campaign=premiera-ksiazki&utm_content=konsultacje-dol">Zobacz książkę →</a></p>
    </section>

    <section class="blok kim">
      <h2>Kim jestem — i kim nie jestem</h2>
      <div class="kim-wiersz">
      <Image src={zdjecie} alt="Michał Hebda" widths={[320, 480]} sizes="180px" loading="lazy" class="portret" />
      <p>Przez 20 lat pracowałem w korporacjach: od specjalisty po senior managera w finansach.
        Dawałem oceny i je dostawałem. Pisałem plany naprawcze i widziałem z bliska, jak kończą się
        jedne i drugie. Siedziałem na kalibracjach, negocjowałem porozumienia.</p>
      </div>
      <p class="uwaga"><strong>Nie jestem psychologiem ani prawnikiem</strong> — i nie udaję żadnego z nich.
        Jeśli Twoja sytuacja wymaga pomocy prawnej albo wsparcia psychologicznego, pomogę Ci ją
        uporządkować i powiem wprost, do kogo się zwrócić. Konsultacja ze mną to praktyczna wiedza
        o tym, jak działa korporacyjny system i jak się w nim poruszać — nie porada prawna
        i nie terapia.</p>
    </section>

    <section class="blok umow" id="umow">
      <h2>Umów rozmowę</h2>
      <p class="podtytul">Płacisz online {CENA.baza} zł (z VAT; kod subskrybenta wpisujesz w koszyku).
        W ciągu 24 godzin piszę do Ciebie z propozycją terminów — rozmowa zwykle w ciągu kilku dni.
        Jeśli okaże się, że nie jestem właściwą osobą, zwracam całą kwotę.</p>
      <a class="btn btn-primary" href={KOSZYK_KONSULTACJA} data-koszyk="konsultacja">Umów i opłać konsultację — {CENA.baza} zł</a>
      <p class="umow-pod">Faktura VAT: wpisz NIP w koszyku.</p>
    </section>

    <section class="blok" id="formularz">
      <h2>Wolisz najpierw napisać?</h2>
      <p class="podtytul">Dwa, trzy zdania wystarczą. Odpowiadam w ciągu 48 godzin —
        także wtedy, gdy uznam, że nie jestem właściwą osobą.</p>

      <form id="f-konsultacje" novalidate>
        <div class="pole">
          <label for="imie">Imię</label>
          <input id="imie" name="imie" type="text" autocomplete="given-name" required maxlength="80" />
        </div>
        <div class="pole">
          <label for="email">E-mail</label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="160" />
        </div>
        <div class="pole">
          <label for="sytuacja">Co się dzieje?</label>
          <textarea id="sytuacja" name="sytuacja" rows="5" required maxlength="4000"
            placeholder="Np. Dostałem PIP w zeszłym tygodniu, mam trzy cele do zrealizowania w miesiąc i rozmowę kontrolną za dwa tygodnie."></textarea>
        </div>
        <div class="pole">
          <label for="kod">Kod rabatowy <span class="opcjonalne">— jeśli masz</span></label>
          <input id="kod" name="kod" type="text" maxlength="40" autocomplete="off" />
        </div>

        <div class="pole">
          <label for="skad">Skąd o mnie wiesz?</label>
          <select id="skad" name="skad" required>
            <option value="">— wybierz —</option>
            <option value="youtube">YouTube</option>
            <option value="newsletter">Newsletter / checklista</option>
            <option value="grupa-fb">Grupa na Facebooku</option>
            <option value="polecenie">Polecenie od kogoś</option>
            <option value="reklama">Reklama</option>
            <option value="inne">Inne</option>
          </select>
        </div>
        <div class="pole" id="pole-skad-inne" hidden>
          <label for="skad_inne">A dokładniej? <span class="opcjonalne">— jedno zdanie wystarczy</span></label>
          <input id="skad_inne" name="skad_inne" type="text" maxlength="120" autocomplete="off" />
        </div>

        {/* Pułapka na boty — ukryta przed człowiekiem, kuszące dla automatu. */}
        <div class="pulapka" aria-hidden="true">
          <label for="firma">Firma</label>
          <input id="firma" name="firma" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <label class="zgoda">
          <input id="zgoda" name="zgoda" type="checkbox" required />
          <span>Zgadzam się, żeby Michał Hebda skontaktował się ze mną w sprawie tego zapytania.
            Dane wykorzystamy wyłącznie w tym celu — szczegóły w <a href="/prywatnosc/">polityce prywatności</a>.</span>
        </label>

        <button class="btn btn-primary" type="submit">Wyślij zapytanie</button>
        <p class="komunikat" id="komunikat" role="status" aria-live="polite"></p>
      </form>
    </section>
  </main>

  <Stopka />

  <script is:inline>
    (function () {
      var f = document.getElementById('f-konsultacje');
      var kom = document.getElementById('komunikat');
      if (!f) return;

      /* ?kod=… w adresie wypełnia pole kodu (2.11: oferta po zakupie książki,
         /ksiazka/dziekuje-za-zakup/ → CZYTELNIK149). Tylko litery/cyfry/myślnik. */
      try {
        var kodZUrl = new URLSearchParams(location.search).get('kod');
        if (kodZUrl && /^[A-Za-z0-9-]{3,40}$/.test(kodZUrl) && f.kod && !f.kod.value) f.kod.value = kodZUrl.toUpperCase();
      } catch (e) {}

      /* Kliknięcia w koszyki (3.11.2026): Vercel `konsultacje_koszyk` z rodzajem. */
      document.querySelectorAll('a[data-koszyk]').forEach(function (a) {
        a.addEventListener('click', function () {
          try { if (window.va) window.va('event', { name: 'konsultacje_koszyk', data: { produkt: a.dataset.koszyk } }); } catch (e) {}
        });
      });

      /* Pole „a dokładniej?" pokazuje się tylko po wybraniu „Inne" —
         reszcie osób nie zawracamy głowy dodatkowym polem. */
      var skad = document.getElementById('skad');
      var poleInne = document.getElementById('pole-skad-inne');
      if (skad && poleInne) {
        skad.addEventListener('change', function () {
          poleInne.hidden = skad.value !== 'inne';
        });
      }

      /* Zdarzenie „Contact" leci do Mety i Google TYLKO wtedy, gdy ktoś
         wcześniej zgodził się na ciasteczka. Bez zgody formularz działa
         normalnie, po prostu nikt się o tym nie dowiaduje poza nami. */
      function zglosKonwersje() {
        /* content_category rozdziela konsultacje od zapytań firmowych (to samo
           zdarzenie Contact wysyła /dziekuje-firmy) — decyzja Klaudiusza 17.09. */
        if (window.fbq) window.fbq('track', 'Contact', { content_category: 'konsultacje' });
        if (window.gtag) window.gtag('event', 'generate_lead', { value: 299, currency: 'PLN' });
      }

      f.addEventListener('submit', async function (e) {
        e.preventDefault();
        var btn = f.querySelector('button[type=submit]');
        kom.className = 'komunikat';
        kom.textContent = '';
        btn.disabled = true;
        btn.textContent = 'Wysyłam…';
        try {
          var r = await fetch('/api/konsultacje/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              imie: f.imie.value,
              email: f.email.value,
              sytuacja: f.sytuacja.value,
              kod: f.kod.value,
              skad: f.skad.value,
              skad_inne: f.skad_inne ? f.skad_inne.value : '',
              firma: f.firma.value,
              zgoda: f.zgoda.checked,
              zrodlo: document.referrer || location.search || '',
            }),
          });
          var d = await r.json();
          if (!r.ok) throw new Error(d.error || 'Coś poszło nie tak.');
          f.style.display = 'none';
          kom.className = 'komunikat ok';
          kom.textContent = 'Dostałem. Odpowiadam w ciągu 48 godzin — sprawdź też zakładkę „Oferty” i spam, gdyby moja odpowiedź tam wpadła.';
          zglosKonwersje();
          try { if (window.va) window.va('event', { name: 'konsultacje_wyslane' }); } catch (e) {}
        } catch (err) {
          kom.className = 'komunikat blad';
          kom.textContent = err.message;
          btn.disabled = false;
          btn.textContent = 'Wyślij zapytanie';
        }
      });
    })();
  </script>
</Layout>

<style>
.khead{padding:64px 0 40px;border-bottom:1px solid var(--linia)}
.khead h1{font-family:var(--disp);font-weight:500;font-size:clamp(30px,5vw,46px);
  line-height:1.12;margin:6px 0 18px;max-width:20ch}
.lead{font-size:clamp(16px,2.2vw,19px);color:#3C4A46;max-width:60ch;margin-bottom:26px}
.blok{padding:44px 0;border-bottom:1px solid var(--linia)}
.blok:last-of-type{border-bottom:0}
.blok h2{font-size:clamp(22px,3vw,28px);margin-bottom:18px}
.podtytul{color:#4A5A55;max-width:58ch;margin-bottom:24px}
.lista{list-style:none}
.lista li{padding-left:26px;position:relative;margin-bottom:12px;font-size:16.5px;max-width:64ch}
.lista li::before{content:"—";position:absolute;left:0;color:var(--sygnal)}
.kroki{list-style:none;counter-reset:k}
.kroki li{counter-increment:k;padding-left:44px;position:relative;margin-bottom:18px;max-width:64ch}
.kroki li::before{content:counter(k);position:absolute;left:0;top:-2px;width:28px;height:28px;
  border-radius:99px;background:var(--sygnal);color:#fff;display:grid;place-items:center;
  font-family:var(--mono);font-size:13px}
.ceny{display:grid;grid-template-columns:repeat(2,1fr);gap:20px}
.kotwica{font-size:16px;color:#4A5A55;max-width:64ch;margin-bottom:22px}
.pilnosc{font-size:16px;color:#3C4A46;max-width:58ch;margin:0 0 22px;
  padding-left:14px;border-left:3px solid var(--sygnal)}
.cena .termin{margin-top:10px;font-size:14px;color:#5A6A65}
@media(max-width:760px){.ceny{grid-template-columns:1fr}}
.cena{background:var(--papier);border:1px solid var(--linia);border-radius:10px;padding:26px 24px}
.head-cta{display:flex;gap:14px;flex-wrap:wrap}
@media(min-width:761px){.ceny .pip{grid-column:1 / -1}}
.cena.pip{border-color:var(--sygnal);box-shadow:0 0 0 1px var(--sygnal) inset;scroll-margin-top:90px}
.pip-lista{margin:10px 0 12px 18px;font-size:15px;color:#3C4A46}
.pip-lista li{margin-bottom:8px}
.cena.pip .btn{margin-top:14px}
.umow .btn{margin-top:4px}
.umow-pod{font-size:14px;color:#5A6A65;margin-top:10px}
#umow,#formularz{scroll-margin-top:80px}
.cena.wyroznione{border-color:var(--sygnal);box-shadow:0 0 0 1px var(--sygnal) inset}
.etykieta{font-family:var(--mono);font-size:11.5px;letter-spacing:.09em;text-transform:uppercase;
  background:var(--marker);color:#6B5A14;padding:4px 10px;border-radius:99px;display:inline-block;margin-bottom:12px}
.kwota{font-family:var(--disp);font-size:32px;color:var(--sygnal);margin-bottom:6px}
.kwota .stara{color:#8A9A95;font-size:21px;margin-right:10px;font-weight:400}
.kwota .badge{font-family:var(--mono);font-size:12px;background:var(--sygnal);color:#fff;
  padding:3px 8px;border-radius:99px;vertical-align:middle;margin-left:8px}
.cena h3{font-size:18px;margin-bottom:8px}
.cena p{font-size:15px;color:#4A5A55}
.kim p{max-width:64ch;margin-bottom:14px}
.kim-wiersz{display:flex;gap:24px;align-items:flex-start;margin-bottom:14px}
.portret{width:180px;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:center 30%;flex-shrink:0;
  border-radius:12px;border:1px solid var(--linia)}
@media(max-width:640px){.kim-wiersz{flex-direction:column;gap:16px}}
.przyklad-nota{font-size:14.5px;color:#5A6A65;margin:-8px 0 18px}
.przyklad-kroki{max-width:64ch}
.przyklad-kroki dt{font-weight:700;color:var(--sygnal);margin-top:14px}
