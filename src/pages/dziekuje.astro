---
import Layout from '../layouts/Layout.astro';
import { stanOferty, LINK_EBOOK } from '../data/oferta-dziekuje.js';

/* Oferta książki (brief Klaudiusza 18.10): stan A/B/C liczony przy każdym
   wejściu, po czasie Warszawy — patrz src/data/oferta-dziekuje.js.
   Renderowanie na serwerze, żeby przed 2.11 w HTML-u nie było ceny ani linku
   do EasyCart. */
export const prerender = false;
const stan = stanOferty(Date.now(), import.meta.env.OFERTA_DZIEKUJE_STAN);

/**
 * Strona po zapisie na checklistę.
 *
 * Powstała, bo Klaudiusz w zadaniu z 5.08 zakłada „stronę podziękowania po
 * zapisie — na niej event konwersji", a takiej strony nie było: formularz
 * MailerLite pokazywał komunikat w miejscu, bez przekierowania. Bez osobnego
 * adresu nie ma czego zmierzyć.
 *
 * ✅ 6.08: przekierowanie ustawione w MailerLite (formularz `by0euU`,
 * Success message → Settings → Custom success page → Redirect URL).
 *
 * ✅ 18.10: double opt-in na formularzu `by0euU` jest WYŁĄCZONY od 3.09
 * (MailerLite_naprawa-double-opt-in_03-09). Checklista wychodzi od razu
 * (automatyzacja „Simple welcome email”, trigger: wejście do grupy), więc treść
 * mówi „checklista jest w drodze”. Poniżej historyczny opis stanu sprzed 3.09.
 *
 * (historycznie) FORMULARZ MIAŁ WŁĄCZONE PODWÓJNE POTWIERDZENIE (double opt-in), więc ta
 * strona pokazuje się PO WYSŁANIU formularza, a nie po potwierdzeniu adresu.
 * Dwie konsekwencje, obie policzone świadomie:
 *   1. Treść mówi „został jeden klik", a nie „checklista jest w drodze" —
 *      inaczej ludzie czekaliby na plik, który bez potwierdzenia nie przyjdzie.
 *   2. Konwersja liczy WYSŁANIE formularza, nie potwierdzony zapis. MailerLite
 *      nie pozwala przekierować strony po potwierdzeniu (sprawdzone 6.08 —
 *      to szablon hostowany u nich, bez opcji redirectu), więc innego momentu
 *      po prostu nie ma. Różnicę między jednym a drugim widać w MailerLite
 *      i warto ją znać, zanim zacznie się optymalizować kampanie po tej liczbie.
 *
 * Zdarzenie konwersji leci TYLKO wtedy, gdy użytkownik zgodził się na piksele.
 * Bez zgody strona po prostu dziękuje i nic nie wysyła.
 */
---
<Layout
  title="Checklista jest w drodze — Michał bez Stresu"
  description="Checklista jest już w Twojej skrzynce albo dotrze za kilka minut."
  noindex
>
  <main class="lp">
    <div class="lp-wrap">
      <div class="brand mono">Michał bez Stresu</div>

      <div class="eyebrow">Gotowe</div>
      <h1>Checklista jest w drodze</h1>
      <p class="sub">Wysłałem Ci maila <strong>„Twoja checklista: jak dokumentować trudne
        sytuacje w pracy”</strong> — w środku jest link do pobrania PDF-a.
        Zwykle dochodzi w ciągu minuty.</p>
      <p class="sub">Nie widzisz maila w ciągu kilku minut? Zajrzyj do zakładki „Oferty”
        albo do spamu i przenieś wiadomość do odebranych — dzięki temu kolejne trafią
        już tam, gdzie trzeba.</p>

      <ul class="benefits">
        <li>Wzór notatki po trudnej rozmowie — kto, co, kiedy i przy kim</li>
        <li>10 gotowych zdań odpowiedzi na niesprawiedliwy feedback</li>
        <li>Gdzie trzymać dokumentację (i dlaczego nie na służbowym laptopie)</li>
      </ul>

      <p class="dalej">
        W międzyczasie: <a href="/#odcinki">odcinek o dokumentowaniu</a> pokazuje krok po
        kroku, jak używać tego wzoru w praktyce.
      </p>
      <p class="dalej">
        Masz przed sobą rozmowę o podwyżce?
        <a href="/symulator/podwyzka/">Przećwicz ją w symulatorze</a> — 5 sytuacji, 3 minuty.
      </p>

      <p class="fineprint">Zero spamu. Wypisujesz się jednym kliknięciem.</p>

      <section class="oferta" data-stan={stan} aria-labelledby="oferta-tytul">
        <img class="oferta-okladka" src="/ksiazka/okladka-nb1-600x960.jpg" width="600" height="960"
          alt="Okładka e-booka „Z obu stron stołu” Michała Hebdy" loading="lazy" decoding="async" />
        <div class="oferta-txt">
          {stan === 'A' ? (
            <>
              <h2 id="oferta-tytul">A jeśli rozmowa jest bliżej, niż myślisz…</h2>
              <p>2 listopada wydaję e-booka <strong>„Z obu stron stołu”</strong> — o rozmowach
                o podwyżce, ocenie, planie naprawczym i odejściu, opowiedzianych z perspektywy
                pracownika i menedżera. Osoby z listy premierowej, które kupią go w pierwszym
                tygodniu (2–8 listopada), dostaną egzemplarz z imienną dedykacją.</p>
              <a class="oferta-btn" href="/ksiazka/#zapis" data-cta="A">Zapisuję się na listę premierową</a>
              <p class="oferta-pod"><a href="/ksiazka/#fragment" data-cta-fragment>Najpierw przeczytaj fragment</a></p>
            </>
          ) : (
            <>
              <h2 id="oferta-tytul">Chcesz pełny plan na tę rozmowę?</h2>
              <p><strong>„Z obu stron stołu”</strong> to e-book o rozmowach, od których zależy kariera:
                podwyżka, ocena roczna, plan naprawczy, odejście. Każda rozmowa opisana z obu stron
                stołu — co myśli menedżer i co możesz zrobić, zanim usiądziesz.</p>
              <ul class="oferta-punkty">
                <li>Co zapytać, gdy szef mówi, że nie ma budżetu</li>
                <li>Pierwszy tydzień planu naprawczego — zanim coś podpiszesz</li>
                <li>Jak wyjść z firmy i nie zostawić niczego na stole</li>
              </ul>
              <p class="oferta-cena">{stan === 'B' ? '39 zł (z VAT) do 15 listopada' : '49 zł (z VAT)'}</p>
              <a class="oferta-btn" href={LINK_EBOOK} data-cta={stan}>Kupuję e-book za {stan === 'B' ? '39' : '49'} zł</a>
              <p class="oferta-pod">EPUB + PDF, od razu na maila. · <a href="/ksiazka/#fragment" data-cta-fragment>Przeczytaj fragment</a></p>
              {/* Opinie recenzentów: dopiero po zgodach (po 29.10), z dopiskiem
                  „otrzymał(a) egzemplarz recenzencki od autora”. Do tego czasu brak sekcji. */}
            </>
          )}
        </div>
      </section>
    </div>
  </main>

  <script is:inline>
    /* Ścieżka startowa (SciezkaStartowa.astro): zapis z wybranej ścieżki.
       Vercel Web Analytics, bez ciasteczek — nie zależy od zgody na piksele. */
    (function () {
      try {
        var s = sessionStorage.getItem('mbs_sciezka');
        if (s && !sessionStorage.getItem('mbs_sciezka_zapis')) {
          sessionStorage.setItem('mbs_sciezka_zapis', '1');
          if (window.va) window.va('event', { name: 'sciezka_zapis', data: { sciezka: s } });
        }
      } catch (e) {}
    })();
  </script>

  <script is:inline>
    (function () {
      var wyslane = false;
      function konwersja() {
        if (wyslane) return;
        wyslane = true;
        /* Zaawansowane dopasowywanie — krok 2 z 2 (22.09.2026).
           LeadMagnet.astro odlozyl adres z formularza checklisty. Doinicjowanie
           piksela tym adresem sprawia, ze Meta potrafi powiazac konwersje
           z konkretna osoba — bez tego zostaja same ciasteczka.
           Zakres jest waski celowo: dzieje sie to WYLACZNIE tutaj, przy
           zdarzeniu Lead z checklisty. Formularz konsultacji nie jest objety
           (patrz komentarz w Trackery.astro i polityka prywatnosci).
           Adresu nie haszujemy — robi to piksel. Kasujemy go zaraz po uzyciu. */
        var em = null;
        try { em = sessionStorage.getItem('mbs_lead_em'); } catch (e) {}
        if (window.fbq && em && window.mbsMetaId) {
          window.fbq('init', window.mbsMetaId, { em: em });
        }
        try { sessionStorage.removeItem('mbs_lead_em'); } catch (e) {}

        if (window.fbq) window.fbq('track', 'Lead');
        /* Dokładny snippet z Google Ads dla akcji „Checklista - zapis na liste".
           Etykieta po ukośniku jest przypisana do TEJ akcji konwersji — bez niej
           Google zaliczy zdarzenie do niczego. Wartość 1 PLN to wartość domyślna
           z ustawień akcji, nie realna wycena leada. */
        if (window.gtag) window.gtag('event', 'conversion', {
          send_to: 'AW-18374464641/CUDbCLnijt0cEIGp0LlE',
          value: 1.0,
          currency: 'PLN',
        });
      }
      /* Trackery.astro daje znać, kiedy fbq/gtag faktycznie istnieją. */
      document.addEventListener('mbs:trackery-gotowe', konwersja);
      if (window.fbq || window.gtag) konwersja();
    })();
  </script>
  <script is:inline>
    /* Kliknięcie w ofertę książki (brief 18.10): GA4 `ksiazka_cta_dziekuje`
       ze `stan` = A/B/C — tylko przy zgodzie (gtag działa w Consent Mode).
       Równolegle Vercel Web Analytics (bez ciasteczek), żeby liczba była też
       bez zgody. Zdarzenia Meta tu NIE dokładamy — kampania uczy się na Lead. */
    (function () {
      var a = document.querySelector('.oferta [data-cta]');
      if (!a) return;
      a.addEventListener('click', function () {
        var stan = a.getAttribute('data-cta');
        try { if (window.gtag) window.gtag('event', 'ksiazka_cta_dziekuje', { stan: stan }); } catch (e) {}
        try { if (window.va) window.va('event', { name: 'ksiazka_cta_dziekuje', data: { stan: stan } }); } catch (e) {}
      });
    })();
  </script>

</Layout>

<style>
.lp{min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:var(--sygnal);color:#F2F7F5;padding:56px 24px}
.lp-wrap{width:100%;max-width:620px}
.brand{font-size:12px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--marker);margin-bottom:40px}
.lp .eyebrow{color:var(--marker)}
.lp h1{font-family:var(--disp);font-weight:500;color:#fff;
  font-size:clamp(28px,5vw,44px);line-height:1.12;margin:6px 0 16px}
.lp .sub{font-size:clamp(16px,2.2vw,19px);color:#CFE0DA;max-width:52ch}
.benefits{list-style:none;margin:26px 0 28px}
.benefits li{padding-left:30px;position:relative;margin-bottom:14px;font-size:16px}
.benefits li::before{content:"✓";position:absolute;left:0;color:var(--marker);font-weight:700}
.dalej{font-size:15.5px;color:#CFE0DA}
.dalej a{color:var(--marker)}
.fineprint{margin-top:22px;font-size:12.5px;color:#B9CFC8}

/* Oferta książki (18.10) — pod treścią o checkliście, nie zamiast niej. */
.oferta{margin-top:44px;padding-top:32px;border-top:1px solid rgba(255,255,255,.18);
  display:grid;grid-template-columns:120px 1fr;gap:24px;align-items:start}
.oferta-okladka{width:120px;height:auto;border-radius:4px;box-shadow:0 8px 24px rgba(0,0,0,.28)}
.oferta h2{font-family:var(--disp);font-weight:500;color:#fff;font-size:clamp(21px,3.2vw,27px);
  line-height:1.2;margin:0 0 10px}
.oferta p{font-size:15.5px;color:#CFE0DA;margin-bottom:14px}
.oferta-punkty{list-style:none;margin:0 0 16px}
.oferta-punkty li{padding-left:24px;position:relative;margin-bottom:8px;font-size:15px;color:#E4EEEA}
.oferta-punkty li::before{content:"→";position:absolute;left:0;color:var(--marker)}
.oferta .oferta-cena{font-weight:700;color:#fff;font-size:17px;margin-bottom:12px}
.oferta-btn{display:inline-block;background:var(--marker);color:var(--atrament);font-weight:700;
  text-decoration:none;padding:13px 20px;border-radius:9px;font-size:16px}
.oferta-btn:hover{filter:brightness(.95)}
.oferta .oferta-pod{margin-top:12px;font-size:14px;color:#B9CFC8}
.oferta-pod a{color:var(--marker)}
@media (max-width:560px){
  .oferta{grid-template-columns:1fr;gap:16px}
  .oferta-okladka{width:96px}
}
</style>
