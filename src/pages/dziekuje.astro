---
import Layout from '../layouts/Layout.astro';

/**
 * Strona po zapisie na checklistę.
 *
 * Powstała, bo Klaudiusz w zadaniu z 5.08 zakłada „stronę podziękowania po
 * zapisie — na niej event konwersji", a takiej strony nie było: formularz
 * MailerLite pokazywał komunikat w miejscu, bez przekierowania. Bez osobnego
 * adresu nie ma czego zmierzyć.
 *
 * ⚠️ Żeby to zadziałało, trzeba jeszcze w MailerLite (formularz `by0euU`)
 * ustawić po wysłaniu przekierowanie na https://michalbezstresu.pl/dziekuje
 * — to zmiana w panelu MailerLite, nie w kodzie.
 *
 * Zdarzenie konwersji leci TYLKO wtedy, gdy użytkownik zgodził się na piksele.
 * Bez zgody strona po prostu dziękuje i nic nie wysyła.
 */
---
<Layout
  title="Dziękuję — checklista jest w drodze | Michał bez Stresu"
  description="Checklista dokumentowania trudnych sytuacji w pracy jest w drodze na Twoją skrzynkę."
  noindex
>
  <main class="lp">
    <div class="lp-wrap">
      <div class="brand mono">Michał bez Stresu</div>

      <div class="eyebrow">Zapisane</div>
      <h1>Checklista jest w drodze</h1>
      <p class="sub">Za chwilę dostaniesz maila z linkiem do pobrania. Jeśli nie
        widzisz go w ciągu kilku minut — zajrzyj do zakładki „Oferty" albo do spamu
        i przenieś wiadomość do odebranych. Dzięki temu kolejne trafią już tam, gdzie trzeba.</p>

      <ul class="benefits">
        <li>Wzór notatki po trudnej rozmowie — kto, co, kiedy i przy kim</li>
        <li>10 gotowych zdań odpowiedzi na niesprawiedliwy feedback</li>
        <li>Gdzie trzymać dokumentację (i dlaczego nie na służbowym laptopie)</li>
      </ul>

      <p class="dalej">
        W międzyczasie: <a href="/#odcinki">odcinek o dokumentowaniu</a> pokazuje krok po
        kroku, jak używać tego wzoru w praktyce.
      </p>

      <p class="fineprint">Zero spamu. Wypisujesz się jednym kliknięciem.</p>
    </div>
  </main>

  <script is:inline>
    (function () {
      var wyslane = false;
      function konwersja() {
        if (wyslane) return;
        wyslane = true;
        if (window.fbq) window.fbq('track', 'Lead');
        /* Dokładny snippet z Google Ads dla akcji „Checklista - zapis na liste".
           Etykieta po ukośniku jest przypisana do TEJ akcji konwersji — bez niej
           Google zaliczy zdarzenie do niczego. Wartość 1 PLN to wartość domyślna
           z ustawień akcji, nie realna wycena leada. */
        if (window.gtag) window.gtag('event', 'conversion', {
          send_to: 'AW-18374464641/CUDbCLnijt0cEIGp0LlE',
          value: 1.0,
          currency: 'PLN',
        });
      }
      /* Trackery.astro daje znać, kiedy fbq/gtag faktycznie istnieją. */
      document.addEventListener('mbs:trackery-gotowe', konwersja);
      if (window.fbq || window.gtag) konwersja();
    })();
  </script>
</Layout>

<style>
.lp{min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:var(--sygnal);color:#F2F7F5;padding:56px 24px}
.lp-wrap{width:100%;max-width:620px}
.brand{font-size:12px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--marker);margin-bottom:40px}
.lp .eyebrow{color:var(--marker)}
.lp h1{font-family:var(--disp);font-weight:500;color:#fff;
  font-size:clamp(28px,5vw,44px);line-height:1.12;margin:6px 0 16px}
.lp .sub{font-size:clamp(16px,2.2vw,19px);color:#CFE0DA;max-width:52ch}
.benefits{list-style:none;margin:26px 0 28px}
.benefits li{padding-left:30px;position:relative;margin-bottom:14px;font-size:16px}
.benefits li::before{content:"✓";position:absolute;left:0;color:var(--marker);font-weight:700}
.dalej{font-size:15.5px;color:#CFE0DA}
.dalej a{color:var(--marker)}
.fineprint{margin-top:22px;font-size:12.5px;color:#B9CFC8}
</style>
