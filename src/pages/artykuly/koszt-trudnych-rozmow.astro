 *
 * Tekst: Klaudiusz, `Artykul-B2B_koszt-trudnych-rozmow_v4.md` (9.09), bez zmian.
 * Wdrożenie: Marcin, 14.09. Publikacja: 15.09 (decyzja Michała z 14.09 —
 * przesunięta z 1.10, żeby artykuł zdążył się zaindeksować przed outreachem
 * B2B w październiku).
 *
 * ⚠️ To NIE jest treść dla widzów kanału. Odbiorca: HR, L&D, szefowie operacji
 * w SSC/BPO. Stąd:
 *   • NIE MA CTA do checklisty — tak samo jak na /dla-firm, inny odbiorca,
 *   • jedyne wyjście z tekstu prowadzi do /dla-firm (domknięcie lejka),
 *   • okruszki wracają do /dla-firm, nie do strony głównej — artykuł mieszka
 *     w ścieżce B2B, nie w treściach dla pracowników.
 *
 * Fraza SEO: „koszt trudnych rozmów w firmie" (do weryfikacji w Search Console
 * po dwóch tygodniach — ustalenie z 14.09).
 * Meta description celowo z liczbą: liczby w wynikach wyszukiwania podnoszą CTR.
 *
 * Link do outreachu B2B (wiadomości do L&D) ma własne UTM-y, żeby dało się
 * odróżnić ruch z wiadomości od ruchu z posta:
 *   /artykuly/koszt-trudnych-rozmow?utm_source=linkedin&utm_campaign=b2b_outreach
 */
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Stopka from '../../components/Stopka.astro';

const kanon = 'https://www.michalbezstresu.pl/artykuly/koszt-trudnych-rozmow';

const tytul = 'Ile kosztuje firmę jedna źle przeprowadzona rozmowa';
const opis =
  'Koszt trudnych rozmów w firmie, policzony w godzinach: jedna źle przeprowadzona ' +
  'ocena to 20–50 godzin pracy menedżera, HR i zespołu. Jak policzyć to u siebie.';

const dataPublikacji = '2026-09-15';

const jsonLdExtra = [
  {
    '@type': 'Article',
    '@id': `${kanon}#article`,
    headline: tytul,
    description: opis,
    inLanguage: 'pl-PL',
    datePublished: dataPublikacji,
    dateModified: dataPublikacji,
    author: { '@id': 'https://www.michalbezstresu.pl/#person' },
    publisher: { '@id': 'https://www.michalbezstresu.pl/#person' },
    mainEntityOfPage: kanon,
    about: [
      'trudne rozmowy w pracy',
      'ocena roczna',
      'plan naprawczy (PIP)',
      'rotacja pracowników',
      'szkolenia dla menedżerów',
    ],
    audience: {
      '@type': 'BusinessAudience',
      name: 'HR, L&D, szefowie operacji',
    },
  },
  {
    '@type': 'BreadcrumbList',
    '@id': `${kanon}#okruszki`,
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Start', item: 'https://www.michalbezstresu.pl/' },
      { '@type': 'ListItem', position: 2, name: 'Dla firm', item: 'https://www.michalbezstresu.pl/dla-firm' },
      { '@type': 'ListItem', position: 3, name: tytul, item: kanon },
    ],
