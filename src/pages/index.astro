---
/**
 * Strona główna — przebudowa „sklep, nie kanał” (3.11.2026, decyzja Michała,
 * teksty Klaudiusza 1:1). Kolejność: hero → sytuacje → 3 produkty → kim jestem
 * → checklista → 3 odcinki → produkty jeszcze raz.
 * Jeden H1 (w Hero). SciezkaStartowa.astro i PoCoToRobie.astro zostają w repo,
 * ale nie są już na stronie głównej (treść „po co” przeszła do „Kim jestem”).
 */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Sytuacje from '../components/Sytuacje.astro';
import Produkty from '../components/Produkty.astro';
import OMnie from '../components/OMnie.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import Odcinki from '../components/Odcinki.astro';
import Stopka from '../components/Stopka.astro';

/* hreflang z angielską stroną powitalną /en/ (12.10.2026) — para musi być wzajemna. */
const alternatywy = [
  { hreflang: 'pl', href: 'https://www.michalbezstresu.pl/' },
  { hreflang: 'en', href: 'https://www.michalbezstresu.pl/en/' },
  { hreflang: 'x-default', href: 'https://www.michalbezstresu.pl/' },
];
---
<Layout
  title="Trudne rozmowy w pracy, z obu stron stołu | Michał bez Stresu"
  description="Podwyżka, ocena roczna, plan naprawczy, odejście. Książka, konsultacje i darmowe narzędzia od kogoś, kto 20 lat siedział po obu stronach stołu."
  alternatywy={alternatywy}
>
  <Nav />
  <Hero />
  <Sytuacje />
  <Produkty />
  <OMnie />
  <LeadMagnet />
  <Odcinki ile={3} />
  <Produkty krotko />
  <Stopka />
</Layout>
