---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Odcinki from '../components/Odcinki.astro';
import LeadMagnet from '../components/LeadMagnet.astro';
import Produkty from '../components/Produkty.astro';
import PoCoToRobie from '../components/PoCoToRobie.astro';
import OMnie from '../components/OMnie.astro';
import Stopka from '../components/Stopka.astro';
---
<Layout>
  <Nav />
  <Hero />
  <Odcinki />
  <LeadMagnet />
  <Produkty />
  {/* „Po co to robię" celowo PO produktach, a przed „O mnie": najpierw widz
      wie, co dostaje, potem dlaczego to dostaje za darmo, a dopiero potem
      kim jest osoba, która to mówi. */}
  <PoCoToRobie />
  <OMnie />
  <Stopka />
</Layout>
