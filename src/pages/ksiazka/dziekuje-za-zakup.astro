---
import Layout from '../../layouts/Layout.astro';

/**
 * /ksiazka/dziekuje-za-zakup/ — strona po zakupie e-booka (brief Klaudiusza 2.11).
 * EasyCart: produkt e-book → każdy wariant ceny → „Własna strona podziękowania”
 * przekierowuje tutaj. Pliki i tak idą mailem z EasyCart (+ portal klienta),
 * więc strona mówi „sprawdź maila” i pokazuje następny krok: konsultację.
 * Cena dla czytelników 149 zł do 30.11 (zgoda Michała 2.11, 17:52) — realizowana
 * kodem CZYTELNIK149 (EasyCart, produkt „Konsultacja 60 minut”, do 30.11 23:59),
 * który formularz /konsultacje/ wypełnia sam z parametru ?kod=.
 * Po 30.11 sekcja oferty znika sama (sprawdzane przy każdym wejściu).
 */
export const prerender = false;
const KONIEC_OFERTY = Date.parse('2026-12-01T00:00:00+01:00');
const ofertaAktywna = Date.now() < KONIEC_OFERTY;
const LINK = '/konsultacje/?kod=CZYTELNIK149&utm_source=po-zakupie&utm_medium=strona&utm_campaign=ksiazka#formularz';
---
<Layout
  title="Dziękuję za zakup — Michał bez Stresu"
  description="Pliki e-booka „Z obu stron stołu” są w drodze na Twojego maila."
  noindex
>
  <main class="lp">
    <div class="lp-wrap">
      <div class="brand mono">Michał bez Stresu</div>

      <div class="eyebrow">Dziękuję</div>
      <h1>Pliki są w drodze — sprawdź maila</h1>
      <p class="sub">Mail z EasyCart z przyciskami do <strong>EPUB i PDF</strong> dochodzi zwykle
        w ciągu minuty. Nie widzisz go? Zajrzyj do zakładki „Oferty” albo do spamu.</p>
      <p class="sub">Jeśli jesteś na liście premierowej, osobno dostaniesz ode mnie PDF
        z imienną dedykacją.</p>
      <p class="pomoc">Coś się nie otwiera? Odpisz na dowolnego maila ode mnie albo napisz na
        <a href="mailto:michal@michalbezstresu.pl">michal@michalbezstresu.pl</a>.</p>

      {ofertaAktywna && (
        <section class="oferta" aria-labelledby="oferta-tytul">
          <h2 id="oferta-tytul">Masz już plan na rozmowę. Chcesz go przećwiczyć?</h2>
          <p>Jeśli trudna rozmowa jest blisko — ocena, podwyżka, plan naprawczy — umów
            60 minut ze mną. Przejdziemy Twoją sytuację i przygotujemy, co powiesz
            i o co zapytasz.</p>
          <a class="oferta-btn" href={LINK} data-cta-po-zakupie>Umów konsultację — 149 zł dla czytelników, do 30.11</a>
          <p class="oferta-pod">Zamiast 299 zł. Kod rabatowy wpisze się w formularzu sam.</p>
        </section>
      )}
    </div>
  </main>

  <script is:inline>
    /* Kliknięcie w ofertę konsultacji po zakupie książki (brief 2.11):
       Vercel Web Analytics zawsze (bez ciasteczek), GA4 tylko przy zgodzie. */
    (function () {
      var a = document.querySelector('[data-cta-po-zakupie]');
      if (!a) return;
      a.addEventListener('click', function () {
        try { if (window.va) window.va('event', { name: 'konsultacja_cta_po_zakupie' }); } catch (e) {}
        try { if (window.gtag) window.gtag('event', 'konsultacja_cta_po_zakupie'); } catch (e) {}
      });
    })();
  </script>
</Layout>

<style>
.lp{min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:var(--sygnal);color:#F2F7F5;padding:56px 24px}
.lp-wrap{width:100%;max-width:620px}
.brand{font-size:12px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--marker);margin-bottom:40px}
.lp .eyebrow{color:var(--marker)}
.lp h1{font-family:var(--disp);font-weight:500;color:#fff;
  font-size:clamp(28px,5vw,44px);line-height:1.12;margin:6px 0 16px}
.lp .sub{font-size:clamp(16px,2.2vw,19px);color:#CFE0DA;max-width:52ch;margin-bottom:12px}
.pomoc{font-size:14.5px;color:#B9CFC8;margin-top:8px}
.pomoc a{color:var(--marker)}
.oferta{margin-top:40px;padding:28px 26px;border-radius:14px;background:#F2F7F5;color:#1D2422}
.oferta h2{font-family:var(--disp);font-weight:500;font-size:clamp(22px,3.4vw,28px);
  line-height:1.2;margin:0 0 12px;color:#1D2422}
.oferta p{font-size:16px;line-height:1.55;color:#3C4A46;margin:0 0 18px}
.oferta-btn{display:inline-block;background:var(--sygnal);color:#fff;padding:14px 22px;
  border-radius:10px;font-weight:600;text-decoration:none;line-height:1.3}
.oferta-btn:hover{filter:brightness(1.08)}
.oferta .oferta-pod{font-size:13.5px;color:#5B6B66;margin:12px 0 0}
</style>
