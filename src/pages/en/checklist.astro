---
import Layout from '../../layouts/Layout.astro';

/* Angielska strona zapisu na checklistę — test popytu, wrzesień 2026.
 * Teksty: Klaudiusz (`Checklist-EN_welcome-mail-i-strona_dla-Marcina_23-09.md`).
 * Struktura i style 1:1 z `/checklista` — świadomie, żeby obie strony
 * pozostały tym samym układem w dwóch językach.
 *
 * Bez hreflang do `/checklista`: to NIE są wersje tej samej treści.
 * Polska checklista ma 4 strony (dokumentowanie + dodatek o podwyżce),
 * angielska 2 (samo dokumentowanie). Sparowanie ich znacznikiem hreflang
 * mówiłoby Google'owi nieprawdę.
 *
 * Formularz MailerLite: konto 2494941, formularz kfrfAr, grupa
 * `Checklist EN — lead magnet`, double opt-in WYŁĄCZONY (tak jak w PL) —
 * inaczej obietnica „only one email" na stronie podziękowania byłaby fałszywa.
 */
---
<Layout
  lang="en"
  title="Free checklist: how to document difficult situations at work | Michał bez Stresu"
  description="A note template for the five minutes after a hard conversation, ten sentences for replying calmly to unfair feedback, and where to keep your documentation. Sign up — the checklist arrives by email."
>
  <main class="lp">
    <div class="lp-wrap">
      <div class="brand mono">Michał bez Stresu</div>

      <div class="eyebrow">Free resource</div>
      <h1>How to document difficult situations at work</h1>
      <p class="sub">A two-page checklist for the five minutes after a hard conversation
        with your manager. Written by someone who spent twenty years on both sides of
        that table.</p>

      <ul class="benefits">
        <li>A note template you can fill in five minutes — date, who was there, what was said, what was agreed</li>
        <li>Where to keep your documentation so it survives losing access to your work laptop</li>
        <li>Ten sentences for replying calmly to unfair feedback — in writing, not in the heat of the moment</li>
        <li>Five things not to do, so your notes protect you instead of working against you</li>
      </ul>

      <!-- Formularz MailerLite (embedded) — konto 2494941, formularz kfrfAr -->
      <div class="form-embed">
        <div class="ml-embedded" data-form="kfrfAr"></div>
      </div>

      <p class="fineprint">No spam. One email with the checklist, and you can unsubscribe with one click.</p>
    </div>
  </main>

  <!-- MailerLite Universal -->
  <script is:inline>
    (function(w,d,e,u,f,l,n){w[f]=w[f]||function(){(w[f].q=w[f].q||[])
    .push(arguments);},l=d.createElement(e),l.async=1,l.src=u,
    n=d.getElementsByTagName(e)[0],n.parentNode.insertBefore(l,n);})
    (window,document,'script','https://assets.mailerlite.com/js/universal.js','ml');
    ml('account', '2494941');
  </script>
  <!-- End MailerLite Universal -->
</Layout>

<style>
.lp{min-height:100vh;display:flex;align-items:center;justify-content:center;
  background:var(--sygnal);color:#F2F7F5;padding:56px 24px}
.lp-wrap{width:100%;max-width:620px}
.brand{font-size:12px;letter-spacing:.14em;text-transform:uppercase;
  color:var(--marker);margin-bottom:40px}
.lp .eyebrow{color:var(--marker)}
.lp h1{font-family:var(--disp);font-weight:500;color:#fff;
  font-size:clamp(28px,5vw,44px);line-height:1.12;margin:6px 0 16px}
.lp .sub{font-size:clamp(16px,2.2vw,19px);color:#CFE0DA;max-width:52ch}
.benefits{list-style:none;margin:26px 0 34px}
.benefits li{padding-left:30px;position:relative;margin-bottom:14px;font-size:16px}
.benefits li::before{content:"✓";position:absolute;left:0;color:var(--marker);font-weight:700}
.form-embed{background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.18);
  border-radius:12px;padding:26px 24px}
.fineprint{margin-top:16px;font-size:12.5px;color:#B9CFC8;text-align:center}
</style>
