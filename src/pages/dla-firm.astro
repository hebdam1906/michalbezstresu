---
/**
 * /dla-firm — oferta warsztatów B2B.
 * Tekst: Klaudiusz, `Strona-dla-firm_tekst.md` (3.09). Wdrożenie: Marcin.
 *
 * ⚠️ Ta strona mówi do INNEGO odbiorcy niż reszta serwisu: do managera, HR-owca
 * albo szefa operacji — nie do pracownika w trudnej sytuacji. Stąd rejestr
 * zawodowy i stąd świadome braki:
 *   • NIE MA CTA do checklisty (inny odbiorca, inny cel),
 *   • NIE MA CEN (przy B2B cena wynika z zakresu; podana z góry ustawia sufit),
 *   • formularz idzie do `/dziekuje-firmy`, NIE do `/dziekuje` — tam siedzi
 *     piksel Lead z checklisty i zapis B2B zawyżałby leady w kampanii.
 */
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Stopka from '../components/Stopka.astro';

const warsztaty = [
  {
    nr: '1',
    t: 'Trudne rozmowy dla managerów',
    d: 'Jak przekazać informację, której druga strona nie chce usłyszeć — tak, żeby coś z niej wynikło.',
    pkt: [
      'przygotowanie do rozmowy i to, co się dzieje przed nią',
      'struktura rozmowy korygującej',
      'plan naprawczy: kiedy ma sens, a kiedy jest tylko dokumentacją',
      'rozmowa o rozstaniu',
      'najczęstsze błędy managerów i ich konsekwencje',
    ],
    dla: 'managerowie i liderzy zespołów',
    czas: 'pół dnia',
  },
  {
    nr: '2',
    t: 'Ocena roczna i feedback, które nie generują konfliktów',
    d: 'Dlaczego oceny roczne kończą się rozczarowaniem częściej, niż powinny — i co da się z tym zrobić po stronie prowadzącego.',
    pkt: [
      'feedback ciągły a ocena okresowa',
      'jak formułować oceny, żeby dały się obronić',
      'kalibracja z perspektywy managera',
      'komunikowanie ocen niższych niż oczekiwane',
      'co robić, kiedy pracownik nie zgadza się z oceną',
    ],
    dla: 'managerowie oceniający zespoły, HR',
    czas: 'pół dnia',
  },
  {
    nr: '3',
    t: 'Rozmowy 1:1, które nie są stratą czasu',
    d: 'Piętnaście minut tygodniowo, które w większości firm zamienia się w raportowanie statusu.',
    pkt: [
      'czym 1:1 różni się od statusu',
      'agenda i kto ją ustala',
      'pytania, które faktycznie coś zmieniają',
      'co warto zapisywać po rozmowie i dlaczego',
      'sygnały ostrzegawcze, których nie należy przegapić',
    ],
    dla: 'managerowie i ich zespoły — warsztat działa najlepiej, kiedy obie strony przechodzą go razem',
    czas: '3 godziny',
  },
];

const jakTo = [
  ['Format', 'warsztat, nie wykład — praca na sytuacjach z Waszej organizacji'],
  ['Grupa', '8–15 osób'],
  ['Miejsce', 'stacjonarnie (Kraków i okolice) lub online'],
  ['Język', 'polski lub angielski'],
  ['Materiały', 'zestaw materiałów dla uczestników po warsztacie'],
  ['Kontynuacja', 'opcjonalna sesja follow-up po 30 dniach — omówienie sytuacji, które wydarzyły się w międzyczasie'],
];
---
<Layout
  title="Szkolenia dla firm — trudne rozmowy, feedback, ocena roczna"
  description="Warsztaty dla managerów i zespołów: trudne rozmowy, feedback, ocena roczna, rozmowy 1:1. Prowadzi senior manager z 20 latami w korporacji. PL i EN."
>
  <Nav />

  <header class="phead">
    <div class="wrap">
      <div class="eyebrow">Dla firm</div>
      <h1>Warsztaty dla managerów i zespołów</h1>
      <p class="lead">Większość konfliktów w zespołach nie bierze się ze złej woli. Bierze się
        z rozmów, których nikt nie nauczył ludzi prowadzić — bo w firmach zakłada się, że manager
        po prostu będzie umiał przekazać trudną informację, poprowadzić ocenę roczną albo
        zareagować, kiedy ktoś przestaje sobie radzić.</p>
      <p class="lead">Przez dwadzieścia lat pracowałem w korporacjach, od specjalisty po senior
        managera w operacjach finansowych. Prowadziłem zespoły w środowisku międzynarodowym,
        pisałem plany naprawcze, siedziałem przy kalibracji ocen i po obu stronach rozmów,
        o których nikt nie chce pamiętać.</p>
      <p class="lead mocne">Te warsztaty są zbudowane z tego doświadczenia — nie z teorii zarządzania.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href="#kontakt">Porozmawiajmy</a>
        <span class="cta-note">Odpowiadam w ciągu jednego dnia roboczego.</span>
      </div>
    </div>
  </header>

  <section>
    <div class="wrap">
      <div class="eyebrow">Dla kogo</div>
      <h2>Dla kogo</h2>
      <ul class="dlakogo">
        <li><strong>Zespoły operacyjne w SSC i BPO</strong> — środowisko, w którym przepracowałem większość kariery</li>
        <li><strong>Nowi managerowie</strong>, zwłaszcza awansowani z wewnątrz zespołu — to najtrudniejsze przejście w całej korporacyjnej karierze i najczęściej pozostawiane bez wsparcia</li>
        <li><strong>Doświadczeni liderzy</strong>, którzy prowadzą trudne rozmowy od lat i chcą je robić lepiej</li>
        <li><strong>Działy HR</strong>, które szukają programu opartego na praktyce, a nie na modelu z podręcznika</li>
      </ul>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="eyebrow">Oferta</div>
      <h2>Trzy warsztaty</h2>
      <div class="cards">
        {warsztaty.map((w) => (
          <article class="card">
            <span class="tag">Warsztat {w.nr}</span>
            <h3>{w.t}</h3>
            <p class="cd">{w.d}</p>
            <p class="wprog">W programie</p>
            <ul>{w.pkt.map((p) => <li>{p}</li>)}</ul>
            <p class="meta"><strong>Dla kogo:</strong> {w.dla}<br/><strong>Czas:</strong> {w.czas}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="eyebrow">Organizacja</div>
      <h2>Jak to wygląda</h2>
      <dl class="fakty">
        {jakTo.map(([k, v]) => (<><dt>{k}</dt><dd>{v}</dd></>))}
      </dl>
      <p class="sub">Program dopasowuję do organizacji. Warsztat dla zespołu, który właśnie
        przechodzi reorganizację, wygląda inaczej niż dla zespołu przygotowującego się do
        sezonu ocen.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <div class="eyebrow">Współpraca</div>
      <h2>Jak zaczynamy</h2>
      <div class="steps">
        <div class="step"><span class="snr">1</span><h3>Rozmowa, 30 minut</h3><p>Bez prezentacji i bez zobowiązań — chcę zrozumieć, co się u Was realnie dzieje.</p></div>
        <div class="step"><span class="snr">2</span><h3>Propozycja programu i wycena</h3><p>Konkretny zakres, oparty na tym, co usłyszałem.</p></div>
        <div class="step"><span class="snr">3</span><h3>Warsztat</h3><p>Praca na sytuacjach z Waszej organizacji, w grupie 8–15 osób.</p></div>
        <div class="step"><span class="snr">4</span><h3>Materiały i podsumowanie</h3><p>Dla osoby zamawiającej: co wybrzmiało w grupie, na co warto zwrócić uwagę dalej.</p></div>
      </div>
    </div>
  </section>

  <section class="author">
    <div class="wrap author-in">
      <div>
        <div class="eyebrow">Kto prowadzi</div>
        <h2>Dlaczego ja</h2>
        <p class="sub">Nie jestem trenerem, który przeczytał o zarządzaniu. Jestem managerem,
          który przez dwadzieścia lat te rozmowy prowadził — i który po nich wracał do biurka
          z konsekwencjami.</p>
        <ul class="fakty-lista">
          <li><strong>20 lat w korporacjach</strong>, od specjalisty po senior managera w operacjach finansowych</li>
          <li><strong>Praca w środowisku międzynarodowym</strong>, po polsku i po angielsku</li>
          <li><strong>Lean Six Sigma Black Belt</strong> — podejście procesowe, nie tylko miękkie kompetencje</li>
          <li><strong>Mentor</strong> dla osób spoza własnego działu</li>
          <li><strong>Twórca „Michał bez Stresu"</strong> — podcastu i kanału o trudnych sytuacjach w pracy, który ogląda i słucha rosnąca grupa pracowników polskich korporacji</li>
        </ul>
        <p class="sub">Materiały do warsztatów powstają z tego samego źródła co odcinki:
          z sytuacji, które realnie się zdarzyły.</p>
      </div>
      <div class="badge">
        <span class="mono">notatka służbowa</span>
        <p>„Nie nauczę Waszych managerów mówić ładnych zdań.<br/>Nauczę ich prowadzić trudne
          rozmowy tak, żeby ludzie zostawali, a nie odchodzili."</p>
      </div>
    </div>
  </section>

  <section class="band" id="kontakt">
    <div class="wrap">
      <div class="eyebrow">Kontakt</div>
      <h2>Porozmawiajmy</h2>
      <p class="sub">Napisz kilka zdań o tym, czego potrzebujecie. Odpowiadam w ciągu jednego
        dnia roboczego.</p>

      <form id="fform" class="fform" novalidate>
        <div class="pola">
          <div class="pole">
            <label for="imie">Imię i nazwisko *</label>
            <input id="imie" name="imie" type="text" autocomplete="name" required maxlength="80" />
          </div>
          <div class="pole">
            <label for="firma">Firma *</label>
            <input id="firma" name="firma" type="text" autocomplete="organization" required maxlength="120" />
          </div>
          <div class="pole">
            <label for="email">Służbowy adres e-mail *</label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="160" />
          </div>
          <div class="pole">
            <label for="stanowisko">Stanowisko</label>
            <input id="stanowisko" name="stanowisko" type="text" autocomplete="organization-title" maxlength="120" />
          </div>
          <div class="pole">
            <label for="wielkosc_grupy">Wielkość grupy</label>
            <select id="wielkosc_grupy" name="wielkosc_grupy">
              <option value="">— wybierz —</option>
              <option value="do-10">do 10 osób</option>
              <option value="10-20">10–20 osób</option>
              <option value="20-50">20–50 osób</option>
              <option value="powyzej-50">powyżej 50 osób</option>
              <option value="nie-wiem">jeszcze nie wiem</option>
            </select>
          </div>
          <div class="pole">
            <label for="termin">Preferowany termin</label>
            <input id="termin" name="termin" type="text" maxlength="120" placeholder="np. październik, przed sezonem ocen" />
          </div>
        </div>

        <fieldset class="tematy">
          <legend>Czego dotyczy potrzeba</legend>
          <label><input type="checkbox" name="tematy" value="trudne-rozmowy" /> Trudne rozmowy</label>
          <label><input type="checkbox" name="tematy" value="ocena-feedback" /> Ocena roczna i feedback</label>
          <label><input type="checkbox" name="tematy" value="rozmowy-1-1" /> Rozmowy 1:1</label>
          <label><input type="checkbox" name="tematy" value="inne" /> Inne / nie wiem</label>
        </fieldset>

        <div class="pole">
          <label for="wiadomosc">Wiadomość *</label>
          <textarea id="wiadomosc" name="wiadomosc" rows="5" required maxlength="4000"
            placeholder="Co się u Was dzieje i co chcecie zmienić? Dwa, trzy zdania wystarczą."></textarea>
        </div>

        <div class="pole">
          <label for="skad">Skąd o mnie wiesz? *</label>
          <select id="skad" name="skad" required>
            <option value="">— wybierz —</option>
            <option value="youtube">YouTube</option>
            <option value="newsletter">Newsletter / checklista</option>
            <option value="grupa-fb">Grupa na Facebooku</option>
            <option value="polecenie">Polecenie od kogoś</option>
            <option value="reklama">Reklama</option>
            <option value="inne">Inne</option>
          </select>
        </div>
        <div class="pole" id="pole-skad-inne" hidden>
          <label for="skad_inne">Doprecyzuj</label>
          <input id="skad_inne" name="skad_inne" type="text" maxlength="120" autocomplete="off" />
        </div>

        {/* Pułapka na boty. NIE nazywać jej `firma` — „Firma" to realne, wymagane
            pole tego formularza. Patrz komentarz na górze src/pages/api/firmy.ts. */}
        <div class="pulapka" aria-hidden="true">
          <label for="www">Nie wypełniaj tego pola</label>
          <input id="www" name="www" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <label class="zgoda">
          <input id="zgoda" name="zgoda" type="checkbox" required />
          <span>Zgadzam się, żeby Michał Hebda skontaktował się ze mną w sprawie tego zapytania.
            Dane wykorzystamy wyłącznie w tym celu — szczegóły w <a href="/prywatnosc">polityce prywatności</a>.</span>
        </label>

        <button class="btn btn-primary" type="submit">Wyślij zapytanie</button>
        <p class="komunikat" id="fkom" role="status" aria-live="polite"></p>
      </form>

      <p class="mail-alt">Wolisz mailem? <a href="mailto:kontakt@michalbezstresu.pl?subject=Warsztaty%20dla%20zespo%C5%82u">kontakt@michalbezstresu.pl</a></p>
    </div>
  </section>

  <Stopka />
</Layout>

<script is:inline>
  (function () {
    var f = document.getElementById('fform');
    if (!f) return;
    var kom = document.getElementById('fkom');
    var skad = document.getElementById('skad');
    var poleInne = document.getElementById('pole-skad-inne');

    skad.addEventListener('change', function () {
      poleInne.hidden = skad.value !== 'inne';
    });

    f.addEventListener('submit', async function (e) {
      e.preventDefault();
      kom.className = 'komunikat';
      kom.textContent = '';

      if (!f.checkValidity()) { f.reportValidity(); return; }

      var btn = f.querySelector('button[type=submit]');
      btn.disabled = true;
      var etykieta = btn.textContent;
      btn.textContent = 'Wysyłam…';

      var tematy = Array.prototype.slice
        .call(f.querySelectorAll('input[name=tematy]:checked'))
        .map(function (i) { return i.value; });

      try {
        var r = await fetch('/api/firmy', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            imie: f.imie.value,
            firma: f.firma.value,
            email: f.email.value,
            stanowisko: f.stanowisko.value,
            wielkosc_grupy: f.wielkosc_grupy.value,
            tematy: tematy,
            termin: f.termin.value,
            wiadomosc: f.wiadomosc.value,
            skad: f.skad.value,
            skad_inne: f.skad_inne ? f.skad_inne.value : '',
            www: f.www.value,
            zgoda: f.zgoda.checked,
            /* skąd faktycznie przyszedł ruch — patrz components/Atrybucja.astro */
            atrybucja: window.mbsAtrybucja ? window.mbsAtrybucja() : {},
          }),
        });
        var d = await r.json();
        if (!r.ok) throw new Error(d.error || 'Coś poszło nie tak.');
        /* Podziękowanie ma własną stronę — NIE /dziekuje, bo tam siedzi piksel
           Lead z checklisty i zapytanie B2B zawyżałoby leady w kampanii. */
        location.href = '/dziekuje-firmy';
      } catch (err) {
        btn.disabled = false;
        btn.textContent = etykieta;
        kom.className = 'komunikat blad';
        kom.textContent = err.message || 'Nie udało się wysłać. Napiszcie proszę na kontakt@michalbezstresu.pl.';
      }
    });
  })();
</script>

<style>
.phead{padding:72px 0 60px;background:linear-gradient(180deg,var(--mgla),var(--papier))}
.phead h1{font-family:var(--disp);font-weight:500;font-size:clamp(32px,5vw,54px);line-height:1.12;margin-bottom:22px}
.phead .lead{font-size:clamp(16px,2vw,18.5px);color:#3C4A46;max-width:64ch;margin-bottom:14px}
.phead .lead.mocne{color:var(--sygnal);font-weight:500}
.cta-row{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:30px}
.cta-note{font-size:14px;color:#5E6E68}
.dlakogo{list-style:none;padding:0;margin-top:26px;max-width:70ch;display:grid;gap:14px}
.dlakogo li{padding-left:24px;position:relative;font-size:16px;color:#3C4A46;line-height:1.6}
.dlakogo li::before{content:"→";position:absolute;left:0;color:var(--szalwia)}
.band{background:var(--papier);border-top:1px solid var(--linia);border-bottom:1px solid var(--linia)}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:36px}
@media(max-width:980px){.cards{grid-template-columns:1fr}}
.card{background:var(--mgla);border:1px solid var(--linia);border-radius:12px;padding:28px 26px;display:flex;flex-direction:column}
.card .tag{font-family:var(--mono);font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;background:rgba(46,107,93,.12);color:var(--sygnal);padding:4px 10px;border-radius:99px;align-self:flex-start;margin-bottom:16px}
.card h3{font-size:21px;margin-bottom:10px;line-height:1.25}
.card .cd{font-size:15px;color:#4A5A55;margin-bottom:18px}
.card .wprog{font-family:var(--mono);font-size:11.5px;letter-spacing:.1em;text-transform:uppercase;color:#5E6E68;margin-bottom:10px}
.card ul{list-style:none;padding:0;margin:0 0 18px}
.card li{padding-left:20px;position:relative;font-size:14.5px;margin-bottom:8px;color:#3C4A46;line-height:1.5}
.card li::before{content:"·";position:absolute;left:6px;color:var(--szalwia);font-weight:700}
.card .meta{margin-top:auto;font-size:14px;color:#5E6E68;border-top:1px solid var(--linia);padding-top:14px;line-height:1.6}
.fakty{display:grid;grid-template-columns:180px 1fr;gap:0;margin-top:30px;max-width:76ch;border-top:1px solid var(--linia)}
@media(max-width:640px){.fakty{grid-template-columns:1fr}}
.fakty dt{font-weight:600;padding:14px 16px 14px 0;border-bottom:1px solid var(--linia);color:#2C3A36}
.fakty dd{margin:0;padding:14px 0;border-bottom:1px solid var(--linia);color:#4A5A55}
@media(max-width:640px){.fakty dt{padding-bottom:2px;border-bottom:0}.fakty dd{padding-top:2px}}
.steps{display:grid;grid-template-columns:repeat(4,1fr);gap:24px;margin-top:36px}
@media(max-width:980px){.steps{grid-template-columns:1fr 1fr}}
@media(max-width:600px){.steps{grid-template-columns:1fr}}
.step .snr{display:inline-flex;align-items:center;justify-content:center;width:38px;height:38px;border-radius:50%;background:var(--marker);color:#6B5A14;font-family:var(--disp);font-size:19px;margin-bottom:12px}
.step h3{font-size:18px;margin-bottom:8px}
.step p{font-size:15px;color:#4A5A55}
.author-in{display:grid;grid-template-columns:1.2fr .8fr;gap:44px;align-items:start}
@media(max-width:900px){.author-in{grid-template-columns:1fr}}
.fakty-lista{list-style:none;padding:0;margin:22px 0;display:grid;gap:11px}
.fakty-lista li{padding-left:22px;position:relative;font-size:15.5px;color:#3C4A46;line-height:1.6}
.fakty-lista li::before{content:"—";position:absolute;left:0;color:var(--szalwia)}
.badge{background:var(--sygnal);color:#F2F7F5;border-radius:14px;padding:30px 28px}
.badge .mono{font-family:var(--mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--marker);display:block;margin-bottom:14px}
.badge p{font-family:var(--disp);font-size:20px;line-height:1.45}
.fform{margin-top:32px;max-width:70ch}
.pola{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:700px){.pola{grid-template-columns:1fr}}
.pole{display:flex;flex-direction:column;margin-bottom:16px}
.pole label{font-size:14px;font-weight:500;color:#2C3A36;margin-bottom:6px}
.pole input,.pole select,.pole textarea{font:inherit;font-size:15px;padding:11px 13px;border:1px solid var(--linia);border-radius:8px;background:#fff;color:#2C3A36}
.pole textarea{resize:vertical;min-height:110px}
.pole input:focus,.pole select:focus,.pole textarea:focus{outline:2px solid var(--sygnal);outline-offset:1px}
.tematy{border:1px solid var(--linia);border-radius:8px;padding:14px 16px;margin:4px 0 18px;background:#fff}
.tematy legend{font-size:14px;font-weight:500;color:#2C3A36;padding:0 6px}
.tematy label{display:block;font-size:15px;color:#3C4A46;margin:7px 0}
.pulapka{position:absolute;left:-9999px;width:1px;height:1px;overflow:hidden}
.zgoda{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:#4A5A55;margin:6px 0 22px;max-width:60ch}
.zgoda input{margin-top:3px;flex:0 0 auto}
