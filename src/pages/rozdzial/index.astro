---
import Layout from '../../layouts/Layout.astro';
import RozdzialLP from '../../components/RozdzialLP.astro';
/* /rozdzial — rozdział 1 za darmo, dla reklam ogólnych o książce (brief Klaudiusza 4.11). */
---
<Layout
  title="Rozdział 1 za darmo: „Ten mail właśnie stał się dokumentem” | Michał bez Stresu"
  description="Negatywny feedback przychodzi mailem. Przeczytaj za darmo pierwszy rozdział książki „Z obu stron stołu” — co ten mail naprawdę znaczy i co zrobić w pierwszej godzinie."
  ogObraz="/og/og-ksiazka-v2.jpg"
>
  <RozdzialLP nr="1" eyebrow="Darmowy rozdział · PDF"
    h1="Rozdział 1 za darmo: „Ten mail właśnie stał się dokumentem”"
    lead="Negatywny feedback przychodzi mailem. Zanim odpiszesz, przeczytaj, co ten mail naprawdę znaczy i co zrobić w pierwszej godzinie. Z obu stron stołu, bo przez 20 lat siedziałem po obu."
    przycisk="Wyślij mi rozdział 1" />
</Layout>
