---
/**
 * Baner zgody na cookies analityczno-marketingowe.
 *
 * Zasada (od 7.09.2026): piksel Meta startuje dopiero po kliknięciu
 * „Zgadzam się". Tag Google działa inaczej — ładuje się zawsze, ale w trybie
 * Consent Mode v2 z domyślnym stanem zgody `denied`, więc bez zgody nie
 * zapisuje ciasteczek ani identyfikatorów; kliknięcie „Zgadzam się" przestawia
 * go na `granted`. Powód tej różnicy jest opisany w Trackery.astro —
 * warunkowe ładowanie tagu Google dawało robotowi inną stronę niż
 * użytkownikowi i było jednym z tropów przy zawieszeniu konta reklamowego.
 * Vercel Web Analytics zostaje bez zmian, bo nie używa ciasteczek ani
 * identyfikatorów i zgody nie wymaga.
 *
 * Wybór trzymamy w localStorage (`mbs-zgoda`), nie w ciasteczku — samo
 * zapamiętanie decyzji nie wymaga wtedy niczyjej zgody.
 *
 * Decyzję da się zmienić w każdej chwili: `/prywatnosc` woła
 * `window.mbsZgoda.zmien()`, co czyści wybór i pokazuje baner od nowa.
 *
 * ⚠️ To jest warstwa techniczna, nie opinia prawna. Treść banera i polityki
 * powinien przejrzeć ktoś, kto zna się na RODO.
 *
 * Język (24.09.2026): Layout podaje `lang` ze strony, więc na stronach `/en/*`
 * baner jest po angielsku automatycznie — nie trzeba o tym pamiętać przy
 * każdej nowej podstronie. Mechanika (localStorage, Consent Mode) jest ta sama
 * w obu językach; tłumaczymy wyłącznie teksty.
 */
interface Props { lang?: 'pl' | 'en' }
const { lang = 'pl' } = Astro.props;

const t = lang === 'en'
  ? {
      opis: 'I use Meta and Google tools (cookies) to see whether my materials reach the right people and to show ads. Without your consent they stay off. ',
      polityka: 'Privacy policy',
      politykaUwaga: ' (in Polish)',
      nie: 'Essential only',
      tak: 'I agree',
      krotko: 'Cookies (Meta, Google) only with your consent. ',
    }
  : {
      opis: 'Używamy narzędzi Meta i Google (ciasteczka), żeby sprawdzać, czy nasze materiały trafiają do właściwych osób, i pokazywać reklamy. Bez Twojej zgody ich nie uruchamiamy. ',
      polityka: 'Polityka prywatności',
      politykaUwaga: '',
      nie: 'Tylko niezbędne',
      tak: 'Zgadzam się',
      krotko: 'Ciasteczka Meta i Google tylko za Twoją zgodą. ',
    };
---

<div id="zgody" class="zgody" hidden role="dialog" aria-live="polite"
     aria-label={lang === 'en' ? 'Cookie consent' : 'Zgoda na ciasteczka'} aria-describedby="zgody-opis">
  <p id="zgody-opis" class="zgody-tresc">
    <span class="zgody-dlugi">{t.opis}</span><span class="zgody-krotki">{t.krotko}</span><a href="/prywatnosc/"
      hreflang={lang === 'en' ? 'pl' : undefined}
      lang={lang === 'en' ? 'pl' : undefined}>{t.polityka}</a>{t.politykaUwaga}
  </p>
  <div class="zgody-przyciski">
    <button type="button" id="zgody-nie" class="btn btn-ghost">{t.nie}</button>
    <button type="button" id="zgody-tak" class="btn btn-primary">{t.tak}</button>
  </div>
</div>

<script is:inline>
  (function () {
    var KLUCZ = 'mbs-zgoda';
    var baner = document.getElementById('zgody');

    function stan() {
      try { return localStorage.getItem(KLUCZ); } catch (e) { return null; }
    }
    function zapisz(v) {
      try { localStorage.setItem(KLUCZ, v); } catch (e) {}
    }

    window.mbsZgoda = {
      stan: stan,
      udzielona: function () { return stan() === 'tak'; },
      /** wywoływane ze strony /prywatnosc — kasuje wybór i pokazuje baner */
      zmien: function () {
        try { localStorage.removeItem(KLUCZ); } catch (e) {}
        if (baner) baner.hidden = false;
      },
    };

    function rozstrzygnij(v) {
      zapisz(v);
      if (baner) baner.hidden = true;
      if (v === 'tak') {
        // Trackery.astro nasłuchuje i dopiero teraz wstrzykuje skrypty.
        document.dispatchEvent(new CustomEvent('mbs:zgoda'));
      }
    }

    if (baner) {
      if (!stan()) baner.hidden = false;
      var tak = document.getElementById('zgody-tak');
      var nie = document.getElementById('zgody-nie');
      if (tak) tak.addEventListener('click', function () { rozstrzygnij('tak'); });
      if (nie) nie.addEventListener('click', function () { rozstrzygnij('nie'); });
    }
  })();
</script>

<style>
/* 30.10.2026: kompaktowy pasek zamiast dużej karty — wcześniej na telefonie
   zasłaniał ok. 40% ekranu razem z głównym przyciskiem strony. */
.zgody{
  position:fixed;left:12px;right:12px;bottom:12px;z-index:9999;
  max-width:980px;margin:0 auto;
  background:var(--papier);color:var(--atrament);
  border:1px solid var(--linia);border-radius:12px;
  box-shadow:0 6px 24px rgba(30,43,40,.14);
  padding:12px 14px 12px 18px;
  display:flex;gap:16px;align-items:center;
}
.zgody[hidden]{display:none}
.zgody-tresc{flex:1 1 auto;min-width:0;margin:0;font-size:13.5px;line-height:1.5;color:#4A5A55}
.zgody-tresc a{color:var(--sygnal);text-decoration:underline;white-space:nowrap}
.zgody-przyciski{display:flex;gap:8px;flex:0 0 auto}
.zgody-przyciski .btn{font-size:14px;padding:9px 16px;white-space:nowrap}
.zgody-krotki{display:none}
/* 11.11.2026 (B3): na telefonie niski pasek w jednej linii — nie zasłania formularza na /rozdzial/*. */
@media(max-width:700px){
  .zgody{left:0;right:0;bottom:0;border-radius:0;border-width:1px 0 0;flex-direction:row;align-items:center;gap:8px;padding:7px 8px 7px 12px;box-shadow:0 -2px 10px rgba(30,43,40,.10)}
  .zgody-dlugi{display:none}
  .zgody-krotki{display:inline}
  .zgody-tresc{font-size:11.5px;line-height:1.3}
  .zgody-przyciski{gap:6px}
  .zgody-przyciski .btn{padding:6px 9px;font-size:12px}
}
</style>
