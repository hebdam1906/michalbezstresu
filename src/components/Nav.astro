---
/**
 * Nawigacja. Domyślnie polska; `lang="en"` przełącza na angielską (24.09.2026).
 *
 * Powód: angielski artykuł B2B i `/en/contact` pokazywały polskie menu —
 * „Odcinki", „Książka", „O mnie". Dla kogoś, kto pierwszy raz trafia na stronę
 * z angielskiego posta na LinkedInie, wygląda to jakby coś się zepsuło.
 *
 * ⚠️ Angielskie menu prowadzi WYŁĄCZNIE do stron, które istnieją po angielsku.
 * Nie ma tu odpowiedników „Odcinki", „Konsultacje" czy „Książka" — te treści
 * są po polsku i nie udajemy, że jest inaczej. Ostatnia pozycja, „Polski",
 * mówi to wprost, więc kliknięcie logo (które prowadzi na polską stronę
 * główną) nie jest dla nikogo zaskoczeniem.
 *
 * Dochodzi nowa angielska strona → dopisujemy ją TUTAJ, nie w kopii komponentu.
 */
interface Props { lang?: 'pl' | 'en' }
const { lang = 'pl' } = Astro.props;

const pozycje = lang === 'en'
  ? [
      { href: '/en/articles/cost-of-difficult-conversations/', etykieta: 'Article' },
      { href: '/en/checklist/', etykieta: 'Free checklist' },
      { href: '/en/contact/', etykieta: 'Workshops' },
      { href: '/', etykieta: 'Polski', lang: 'pl' },
    ]
  : [
      { href: '/#odcinki', etykieta: 'Odcinki' },
      { href: '/konsultacje/', etykieta: 'Konsultacje' },
      { href: '/ksiazka/', etykieta: 'Książka' },
      { href: '/dla-firm/', etykieta: 'Dla firm' },
      { href: '/#checklista', etykieta: 'Bezpłatna checklista' },
      { href: '/#omnie', etykieta: 'O mnie' },
    ];
---

<nav>
  <div class="wrap nav-in">
    <a class="logo" href="/">Michał <span>bez Stresu</span></a>
    <ul class="nav-links">
      {pozycje.map((x) => (
        <li>
          <a href={x.href} hreflang={x.lang} lang={x.lang}
             class={x.lang ? 'inny-jezyk' : undefined}>{x.etykieta}</a>
        </li>
      ))}
    </ul>
  </div>
</nav>

<style>
nav{position:sticky;top:0;background:rgba(237,241,239,.9);backdrop-filter:blur(8px);border-bottom:1px solid var(--linia);z-index:50}
.nav-in{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{font-family:var(--disp);font-weight:600;font-size:19px;text-decoration:none}
.logo span{color:var(--sygnal)}
.nav-links{display:flex;gap:22px;list-style:none}
.nav-links a{text-decoration:none;font-size:15px;color:#3C4A46}
.nav-links a:hover{color:var(--sygnal)}
/* Przełącznik języka — wyróżniony, żeby nie ginął wśród pozycji menu. */
.nav-links a.inny-jezyk{font-family:var(--mono);font-size:13px;color:var(--sygnal)}
@media(max-width:980px){.nav-links{gap:16px;font-size:14px}}
@media(max-width:760px){.nav-links{display:none}}
</style>
