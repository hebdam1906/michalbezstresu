---
/** „Kim jestem” (przebudowa 3.11.2026). Kotwice: #kim-jestem (stopka) i #omnie (stare linki). */
import { Image } from 'astro:assets';
import zdjecie from '../assets/michal-hebda.jpg';
---
<section class="omnie" id="kim-jestem">
  <span id="omnie" class="stara-kotwica" aria-hidden="true"></span>
  <div class="wrap omnie-grid">
    <Image src={zdjecie} alt="Michał Hebda" widths={[320, 480, 640]} sizes="(max-width: 880px) 240px, 320px"
      loading="lazy" class="omnie-foto" />
    <div>
      <h2>Kim jestem</h2>
      <p><strong>Michał Hebda.</strong> Przez dwadzieścia lat pracowałem w operacjach finansowych w międzynarodowych instytucjach, od specjalisty po senior menedżera. Byłem oceniany i oceniałem. Dostałem plan naprawczy i wręczałem je innym. Dziś mówię o tych rozmowach głośno, bo zasady znali tylko ci po drugiej stronie stołu.</p>
      {/* Miejsce na opinię z Lubimyczytać (z podpisem i linkiem do źródła) — gdy będzie. */}
      <p class="empik">Książka dostępna w Empiku</p>
    </div>
  </div>
</section>

<style>
.omnie{background:var(--papier);border-top:1px solid var(--linia);scroll-margin-top:64px}
.stara-kotwica{display:block;position:relative;top:-64px}
.omnie-grid{display:grid;grid-template-columns:320px 1fr;gap:48px;align-items:center}
@media(max-width:880px){.omnie-grid{grid-template-columns:1fr;gap:24px}}
.omnie-foto{display:block;width:100%;max-width:320px;height:auto;aspect-ratio:4/5;object-fit:cover;object-position:center 30%;
  border-radius:12px;border:1px solid var(--linia)}
@media(max-width:880px){.omnie-foto{max-width:240px}}
.omnie h2{font-size:clamp(26px,3.6vw,36px);margin-bottom:16px}
.omnie p{font-size:17px;color:#33413C;max-width:60ch;margin-bottom:14px}
.omnie .empik{font-family:var(--mono);font-size:13px;color:var(--sygnal);letter-spacing:.04em}
</style>
