---
/**
 * Hero strony głównej — przebudowa „sklep, nie kanał” (3.11.2026, teksty Klaudiusza 1:1).
 * Jeden H1 na stronie. Jeden przycisk → #sytuacje.
 *
 * Wideo powitalne: wpisz ID filmu z YouTube w WIDEO_YT_ID. Do tego czasu
 * w prawej kolumnie jest samo zdjęcie. Wideo działa jako „fasada”: miniatura
 * (zwykły obraz z wymiarami, bez CLS) + przycisk play; iframe ładuje się
 * dopiero po kliknięciu. Bez autoplay przy wejściu na stronę (zasady SEO 3.11).
 */
import { Image } from 'astro:assets';
import zdjecie from '../assets/michal-hebda.jpg';
import miniatura from '../assets/wideo-powitalne-miniatura.jpg';
/* 3.11.2026: wideo powitalne (YT niepubliczne, napisy wypalone, dźwięk z Q2U). */
const WIDEO_YT_ID = 'D6z5fywUN-8';
/* Liczba odcinków liczona z danych (opublikowane z filmem), nie wpisywana ręcznie. */
import { odcinki } from '../data/odcinki.js';
const dzis = new Date().toISOString().slice(0, 10);
const ileOdc = odcinki.filter((o) => o.data <= dzis && o.yt).length;
const odm = (n: number) => (n === 1 ? 'odcinek' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'odcinki' : 'odcinków');
---
<header class="hero">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow">Trudne rozmowy w pracy · z obu stron stołu</div>
      <h1>Masz przed sobą rozmowę, od której zależy Twoja praca?</h1>
      <p class="lead">Podwyżka, ocena roczna, plan naprawczy, odejście. Przez 20 lat siedziałem po obu stronach stołu. Pokażę Ci, co myśli druga strona i co powiedzieć, zanim usiądziesz.</p>
      {/* 5.11: główny przycisk → /test (brief Klaudiusza 4.11, C). */}
      <a class="btn btn-primary" href="/test/?utm_source=strona&utm_medium=hero&utm_campaign=test">Która rozmowa Cię czeka? Test, 1 min →</a>
      <a class="btn btn-ghost" href="#sytuacje">Wybierz swoją sytuację ↓</a>
      <div class="hero-note">1 900+ osób dostaje mój newsletter · {ileOdc} {odm(ileOdc)} · książka w Empiku i na Lubimyczytać</div>
    </div>

    <div class="hero-media">
      {WIDEO_YT_ID ? (
        <button type="button" class="wideo" data-yt={WIDEO_YT_ID} aria-label="Odtwórz wideo powitalne">
          <Image src={miniatura} alt="Michał Hebda — wideo powitalne, 50 sekund" widths={[480, 720, 960, 1280]}
            sizes="(max-width: 880px) 92vw, 520px" width={1280} height={720} loading="eager" class="hero-mini" />
          <span class="play" aria-hidden="true"></span>
        </button>
        <p class="czas-pod">▶ Wideo powitalne · 50 s · z napisami</p>
      ) : (
        <Image src={zdjecie} alt="Michał Hebda" widths={[360, 540, 720]} sizes="(max-width: 880px) 92vw, 460px"
          width={1080} height={1080} loading="eager" class="hero-foto" />
      )}
    </div>
  </div>
</header>

<script is:inline>
(function () {
  var b = document.querySelector('.hero .wideo');
  if (!b) return;
  b.addEventListener('click', function () {
    var id = b.dataset.yt;
    var f = document.createElement('iframe');
    f.src = 'https://www.youtube-nocookie.com/embed/' + id + '?autoplay=1&rel=0';
    f.title = 'Wideo powitalne — Michał bez Stresu';
    f.allow = 'autoplay; encrypted-media; picture-in-picture';
    f.allowFullscreen = true;
    f.className = 'hero-iframe';
    b.replaceWith(f);
    try { if (window.va) window.va('event', { name: 'wideo_powitalne_play' }); } catch (e) {}
  });
})();
</script>

<style>
.hero{padding:64px 0 80px}
.hero-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:56px;align-items:center}
@media(max-width:880px){.hero-grid{grid-template-columns:1fr;gap:32px}.hero{padding:40px 0 56px}}
.hero h1{font-size:clamp(34px,5.2vw,54px);margin-bottom:20px}
.hero .lead{font-size:18px;color:#43524D;max-width:48ch;margin-bottom:30px}
.hero-note{font-family:var(--mono);font-size:12.5px;color:#5E6E68;margin-top:18px;max-width:52ch}
.hero-media{position:relative}
.hero-foto{display:block;width:100%;max-width:460px;height:auto;aspect-ratio:1/1;object-fit:cover;object-position:center 30%;
  border-radius:14px;border:1px solid var(--linia)}
@media(max-width:880px){.hero-foto{max-width:360px}}
.wideo{position:relative;display:block;padding:0;border:0;background:none;cursor:pointer;width:100%;max-width:520px}
.hero-mini{display:block;width:100%;height:auto;aspect-ratio:16/9;object-fit:cover;border-radius:14px;border:1px solid var(--linia)}
.czas-pod{font-family:var(--mono);font-size:12.5px;color:#4A5A55;margin-top:10px}
.play{position:absolute;left:22%;top:50%;width:76px;height:76px;margin:-38px 0 0 -38px;border-radius:99px;
  background:rgba(46,107,93,.92);box-shadow:0 8px 30px rgba(0,0,0,.25)}
.play::after{content:"";position:absolute;left:31px;top:24px;border-style:solid;border-width:14px 0 14px 22px;
  border-color:transparent transparent transparent #fff}
.hero-iframe{width:100%;max-width:520px;aspect-ratio:16/9;border:0;border-radius:14px}
</style>
