---
/** „W czym jesteś teraz?” — 6 sytuacji → produkty (przebudowa 3.11.2026, teksty Klaudiusza). */
const u = (slug: string) => `utm_source=site&utm_medium=home&utm_campaign=sytuacje&utm_content=${slug}`;
const kafle = [
  { slug: 'podwyzka', tytul: 'Szef mówi, że nie ma budżetu', zdanie: 'Rozmowa o podwyżce zaczyna się tygodnie przed spotkaniem.',
    przycisk: 'Przećwicz w symulatorze (3 min)', href: `/symulator/podwyzka/?${u('podwyzka')}`,
    maly: 'rozdział o podwyżce w książce', malyHref: `/ksiazka/?${u('podwyzka')}` },
  { slug: 'pip', tytul: 'Dostałem plan naprawczy (PIP)', zdanie: 'Pierwsze 48 godzin decyduje o wszystkim. Nic nie podpisuj na gorąco.',
    przycisk: 'Zobacz pakiet „Przetrwaj PIP”', href: `/konsultacje/?${u('pip')}#pip`,
    maly: 'odcinek o planie naprawczym', malyHref: `/odcinki/plan-naprawczy-pip/?${u('pip')}` },
  { slug: 'ocena', tytul: 'Czeka mnie ocena roczna', zdanie: 'Ocena zwykle zapada, zanim usiądziesz. Można to jeszcze zmienić.',
    przycisk: 'Przygotuj się z książką (39 zł)', href: `/ksiazka/?${u('ocena')}`,
    maly: 'albo porozmawiajmy', malyHref: `/konsultacje/?${u('ocena')}` },
  { slug: 'feedback-hr', tytul: 'Dostałem feedback na piśmie albo zaproszenie z HR bez tematu', zdanie: 'Firma dokumentuje od pierwszego dnia. Ty masz do tego takie samo prawo.',
    przycisk: 'Pobierz checklistę (za darmo)', href: '#checklista',
    maly: 'odcinek o spotkaniu z HR', malyHref: `/odcinki/spotkanie-z-hr-bez-tematu/?${u('feedback-hr')}` },
  { slug: 'odejscie', tytul: 'Chcę odejść albo dostałem porozumienie stron', zdanie: 'Pierwsza propozycja prawie nigdy nie jest ostatnią.',
    przycisk: 'Rozdział o odejściu w książce', href: `/ksiazka/?${u('odejscie')}`,
    maly: 'rozmowa przed podpisem', malyHref: `/konsultacje/?${u('odejscie')}` },
  { slug: 'menedzer', tytul: 'Jestem menedżerem albo pracuję w HR', zdanie: 'Trudne rozmowy z zespołem, z obu stron stołu. Warsztaty dla firm.',
    przycisk: 'Porozmawiajmy o Twoim zespole', href: `/dla-firm/?${u('menedzer')}` },
];
---
<section class="sytuacje" id="sytuacje">
  <div class="wrap">
    <h2>W czym jesteś teraz?</h2>
    <p class="sub">Wybierz najbliższe. Pokażę Ci, od czego zacząć.</p>
    <div class="kafle">
      {kafle.map((k) => (
        <article class="kafel">
          <h3>{k.tytul}</h3>
          <p>{k.zdanie}</p>
          <a class="btn btn-primary" href={k.href} data-sytuacja={k.slug}>{k.przycisk}</a>
          {k.maly && <a class="maly" href={k.malyHref} data-sytuacja={k.slug + '-maly'}>{k.maly} →</a>}
        </article>
      ))}
    </div>
  </div>
</section>

<script is:inline>
document.querySelectorAll('a[data-sytuacja]').forEach(function (a) {
  a.addEventListener('click', function () {
    try { if (window.va) window.va('event', { name: 'glowna_sytuacja', data: { sytuacja: a.dataset.sytuacja } }); } catch (e) {}
  });
});
</script>

<style>
.sytuacje{background:var(--papier);border-top:1px solid var(--linia);border-bottom:1px solid var(--linia);scroll-margin-top:64px}
.sytuacje h2{font-size:clamp(26px,3.6vw,36px);margin-bottom:8px}
.kafle{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:32px}
@media(max-width:980px){.kafle{grid-template-columns:1fr 1fr}}
@media(max-width:640px){.kafle{grid-template-columns:1fr}}
.kafel{background:var(--mgla);border:1px solid var(--linia);border-radius:10px;padding:24px 22px;display:flex;flex-direction:column;align-items:flex-start}
.kafel h3{font-size:20px;margin-bottom:8px}
.kafel p{font-size:15px;color:#4A5A55;margin-bottom:18px;flex:1}
.kafel .btn{font-size:15px;padding:12px 16px}
.kafel .maly{margin-top:12px;font-size:14px;color:var(--sygnal);text-decoration:none}
.kafel .maly:hover{text-decoration:underline}
</style>
