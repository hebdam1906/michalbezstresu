{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/panel/sync/",
      "schedule": "0 5 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/|_astro/|_vercel/)(?:.*/)?[^/.]+)",
      "destination": "/:path/",
      "permanent": true
    }
  ]
}
